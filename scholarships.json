      "benefit": "Course fee reimbursement + maintenance allowance",
      "priority": 3,
      "rules": [
        {"field": "category", "op": "in", "value": ["SC"], "label": "Belongs to SC category"},
        {"field": "income", "op": "<=", "value": 250000, "label": "Family income up to Rs 2.5 lakh"},
        {"field": "level", "op": "in", "value": ["Undergraduate", "Postgraduate"], "label": "Studying at post-matric level"}
      ]
    },
